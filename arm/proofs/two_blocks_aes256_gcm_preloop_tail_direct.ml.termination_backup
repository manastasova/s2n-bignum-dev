              fst TWO_BLOCKS_PRELOOP_TAIL_EXEC] THEN
  REPEAT STRIP_TAC THEN
  ENSURES_INIT_TAC "s0" THEN

  (* Steps 1-19: prologue *)
  ARM_STEPS_TAC TWO_BLOCKS_PRELOOP_TAIL_EXEC (1--19) THEN
  RULE_ASSUM_TAC(REWRITE_RULE[
    WORD_RULE `word_sub (word_add x (word 80)) (word 80) = (x:int64)`;
    WORD_RULE `word_add (word_add x (word n)) (word m) = word_add x (word(n+m):int64)`]) THEN
  RULE_ASSUM_TAC(CONV_RULE(TRY_CONV(DEPTH_CONV NUM_ADD_CONV))) THEN
  GCM_ENC_SIMPLIFY_TAC THEN

  (* Steps 20-99: CTR setup + AES rounds on v0, v1 + tail entry *)
  MAP_EVERY (fun n ->
    ARM_STEPS_TAC TWO_BLOCKS_PRELOOP_TAIL_EXEC [n] THEN
    GCM_ENC_SIMPLIFY_TAC) (20--99) THEN

  (* Simplify x5 = word 32 before the conditional branch *)
  RULE_ASSUM_TAC(REWRITE_RULE[
    WORD_RULE `word_sub (word_add x y) x = (y:int64)`]) THEN
  RULE_ASSUM_TAC(CONV_RULE(TRY_CONV WORD_REDUCE_CONV)) THEN
  RULE_ASSUM_TAC(CONV_RULE(TRY_CONV NUM_REDUCE_CONV) o
                 CONV_RULE(TRY_CONV INT_REDUCE_CONV)) THEN

  (* Step 100: b.gt .L256_enc_blocks_more_than_1 (taken since 32 > 16) *)
  ARM_STEPS_TAC TWO_BLOCKS_PRELOOP_TAIL_EXEC [100] THEN

  (* Normalise the nonoverlapping representation so ARM_STEPS_TAC can find
     it during the store at step 101. Without this, `ARM_STEPS_TAC` fails
     with "could not prove that updates will not modify the program code". *)
  RULE_ASSUM_TAC(REWRITE_RULE[ARITH_RULE `18446744073709551616 = 2 EXP 64`]) THEN

  (* Steps 101-153: 2-block GHASH via Karatsuba using h^2 (block 0) and
     h (block 1), followed by Barrett-like reduction. Per-step simplification
     keeps term sizes bounded throughout the 53-step loop. *)
  MAP_EVERY (fun n ->
    ARM_STEPS_TAC TWO_BLOCKS_PRELOOP_TAIL_EXEC [n] THEN
    GCM_ENC_SIMPLIFY_TAC) (101--153) THEN

  (* By step 153 Q19 holds the final GHASH tag as a huge nested pmul
     expression. Stepping the `st1 {v19.16b}, [x3]` at pc+616 without
     abbreviating Q19 would carry this expression through each subsequent
     step, slowing things unmanageably. Abbreviate it using the pattern
     from aesv8_gcm_1block_enc_256.ml (lines 247--259): the abbreviation
     is state-free so it survives DISCARD_OLDSTATE_TAC in later steps. *)
  FIRST_ASSUM(fun th ->
    if can (term_match [] `read Q19 (s:armstate) = (x:int128)`) (concl th)
    then let rhs = rand(concl th) in
         ABBREV_TAC(mk_eq(mk_var("final_xi",type_of rhs), rhs))
    else NO_TAC) THEN

  (* Steps 154-160: rev64 v19, store to xi_ptr, mov x0 = x9 (= 32),
     restore saved D8-D15 registers, LDP d8/d9 with SP post-increment
     (the final LDP sets PC -- no need to step the separate RET).
     Note: we stop at 160, not 161 (the RET) because the postcondition
     is `PC = pc + 640` which is reached *after* the final LDP. *)
  ARM_STEPS_TAC TWO_BLOCKS_PRELOOP_TAIL_EXEC (154--160) THEN

  ENSURES_FINAL_STATE_TAC THEN
  ASM_REWRITE_TAC[]);;


